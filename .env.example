# MedReason-Bench — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never commit real keys.

# ── Frontier APIs ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# ── Open-model providers ──────────────────────────────────────────
TOGETHER_API_KEY=...

# Local Ollama daemon (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# ── Hugging Face (datasets, model cards) ──────────────────────────
HF_TOKEN=hf_...

# ── Eval defaults (override per-run via CLI) ──────────────────────
MEDREASON_DEFAULT_TEMPERATURE=0.0
MEDREASON_DEFAULT_TOP_P=1.0
MEDREASON_DEFAULT_SEED=42

# ── Where raw run logs land. Default is `./results/runs`. ─────────
MEDREASON_RESULTS_DIR=./results/runs
